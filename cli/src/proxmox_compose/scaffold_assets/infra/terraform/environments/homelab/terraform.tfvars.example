# Copy to terraform.tfvars (ignored) and keep secrets/local overrides here.
# Shared non-secret infrastructure settings live in homelab.shared.auto.tfvars.
# If set in ~/.config/proxmox-compose/profiles.yml via TF_VAR_*, do not duplicate
# those values here because terraform.tfvars overrides environment variables.
proxmox_token_secret = "change-me"

# Optional local overrides (uncomment as needed):
# proxmox_endpoint = "https://proxmox.local:8006/api2/json"
# proxmox_token_id = "terraform@pve!proxmox-compose"
# default_lxc_ssh_public_key_path = "~/.ssh/id_ed25519.pub"
# Keep this local in terraform.tfvars (git-ignored); Terraform reads the file in .tf code.

# Optional: Proxmox account with 2FA (TOTP) — use password auth and OTP at run time:
# proxmox_auth_method = "password"
# proxmox_username    = "root@pam"
# proxmox_password    = "change-me"
# Then run: proxmox-compose plan --prompt-proxmox-otp  (or export PROXMOX_VE_OTP manually)
